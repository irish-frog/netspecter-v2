[Unit]
Description=NetSpecter passive TLS metadata inspector
After=network-online.target netspecter-collector.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=netspecter-tls
Group=netspecter-metadata
EnvironmentFile=/etc/netspecter/tls-inspector.env
ExecStart=/opt/netspecter/bin/netspecter-tls-inspector ${CAPTURE_INTERFACE} /run/netspecter-metadata/tls.sock
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_PACKET AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
MemoryMax=160M
CPUQuota=50%
TasksMax=16
LimitNOFILE=64
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
