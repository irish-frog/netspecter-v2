[Unit]
Description=NetSpecter Daily SQLite Maintenance
After=netspecter-collector.service netspecter-web.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/netspecter
ExecStartPre=-/bin/systemctl stop netspecter-collector.service
ExecStart=/opt/netspecter/scripts/daily-db-maintenance.sh
ExecStartPost=-/bin/systemctl start netspecter-collector.service
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
